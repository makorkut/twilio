# ==================================================
# APPLICATION
# ==================================================
APP_NAME="Poliüretan E-Commerce"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=Europe/Istanbul

# ==================================================
# DATABASE
# ==================================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=poliuretan_db
DB_USERNAME=db_user
DB_PASSWORD=your_db_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

# ==================================================
# LOCALIZATION
# ==================================================
DEFAULT_LANG=tr
AVAILABLE_LANGS=tr,en,de,fr
DEFAULT_CURRENCY=TRY
AVAILABLE_CURRENCIES=TRY,EUR,USD

# ==================================================
# PRICING
# ==================================================
PRICE_VISIBILITY=visible
SHOW_CONTACT_FOR_PRICE=false
PRICE_INCLUDES_VAT=true
DEFAULT_VAT_RATE=20

# ==================================================
# CACHE
# ==================================================
CACHE_DRIVER=file
CACHE_PREFIX=polyurethane_
CACHE_TTL=3600

# Redis (optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DATABASE=0

# ==================================================
# SESSION
# ==================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE_NAME=polyurethane_session

# ==================================================
# SECURITY
# ==================================================
APP_KEY=
CSRF_TOKEN_NAME=_csrf_token
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MINUTES=1

# 2FA
ENABLE_TWO_FACTOR_AUTH=false

# ==================================================
# EMAIL / SMTP
# ==================================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ==================================================
# PAYMENT GATEWAYS
# ==================================================
# Stripe
STRIPE_ENABLED=true
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# İyzico
IYZICO_ENABLED=true
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ==================================================
# STORAGE / CDN
# ==================================================
STORAGE_DRIVER=local
FILESYSTEM_DISK=local

# AWS S3 / DigitalOcean Spaces
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=fra1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=https://fra1.digitaloceanspaces.com

CDN_URL=

# ==================================================
# IMAGE PROCESSING
# ==================================================
IMAGE_DRIVER=gd
IMAGE_QUALITY=85
IMAGE_WEBP_ENABLED=true
IMAGE_AVIF_ENABLED=false
IMAGE_SIZES=default,big,small,tiny,thumb

# Watermark
WATERMARK_ENABLED=false
WATERMARK_TEXT=
WATERMARK_OPACITY=50

# ==================================================
# EXTERNAL INTEGRATIONS
# ==================================================
# Local CRM/ERP
LOCAL_CRM_ENABLED=false
LOCAL_CRM_BASE_URL=http://localhost:8080
LOCAL_CRM_API_KEY=
LOCAL_CRM_WEBHOOK_SECRET=

# ==================================================
# WEBSOCKET
# ==================================================
WEBSOCKET_ENABLED=false
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8080

# ==================================================
# QUEUE
# ==================================================
QUEUE_DRIVER=database
QUEUE_WORKER_SLEEP=3
QUEUE_MAX_ATTEMPTS=3

# ==================================================
# API
# ==================================================
API_ENABLED=true
API_RATE_LIMIT=100
API_JWT_SECRET=your_jwt_secret_key_change_this
API_JWT_TTL=3600

# ==================================================
# SEO
# ==================================================
SITEMAP_ENABLED=true
SITEMAP_CACHE_TTL=86400
RSS_ENABLED=true

# ==================================================
# FEATURES (Enable/Disable)
# ==================================================
FEATURE_BLOG=true
FEATURE_WISHLIST=true
FEATURE_REVIEWS=true
FEATURE_COMPARISON=true
FEATURE_B2B=true
FEATURE_SUBSCRIPTION=true
FEATURE_WAREHOUSE=true
FEATURE_AFFILIATE=true
FEATURE_PROJECTS=true
FEATURE_TECHNICAL_DOCS=true
FEATURE_SAMPLE_ORDERS=true

# ==================================================
# ANALYTICS
# ==================================================
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=

# ==================================================
# THIRD-PARTY
# ==================================================
# reCAPTCHA
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Live Chat
CHATWOOT_ENABLED=false
CHATWOOT_BASE_URL=
CHATWOOT_WEBSITE_TOKEN=

# WhatsApp Business
WHATSAPP_ENABLED=false
WHATSAPP_NUMBER=

# ==================================================
# MAINTENANCE
# ==================================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Site bakımdadır. Kısa süre sonra açılacaktır."
