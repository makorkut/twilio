{
    "name": "poliuretan/ecommerce-cms",
    "description": "Advanced Multi-language E-commerce + CMS with Automation (MCP Architecture)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "ext-openssl": "*",
        "ext-zip": "*",
        "ext-fileinfo": "*",
        "ext-exif": "*",
        "ext-gd": "*",
        "ext-bcmath": "*",
        "vlucas/phpdotenv": "^5.5",
        "symfony/http-foundation": "^6.3",
        "symfony/routing": "^6.3",
        "nikic/fast-route": "^1.3",
        "twig/twig": "^3.7",
        "monolog/monolog": "^3.4",
        "intervention/image": "^2.7",
        "dompdf/dompdf": "^2.0",
        "phpoffice/phpspreadsheet": "^1.29",
        "guzzlehttp/guzzle": "^7.8",
        "stripe/stripe-php": "^13.0",
        "firebase/php-jwt": "^6.8",
        "league/csv": "^9.11",
        "league/flysystem": "^3.15",
        "league/flysystem-aws-s3-v3": "^3.15",
        "aws/aws-sdk-php": "^3.281",
        "predis/predis": "^2.2",
        "ratchet/pawl": "^0.4",
        "cboden/ratchet": "^0.4",
        "phpmailer/phpmailer": "^6.8",
        "spatie/image-optimizer": "^1.7",
        "ramsey/uuid": "^4.7",
        "nesbot/carbon": "^2.69"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.3",
        "mockery/mockery": "^1.6",
        "fakerphp/faker": "^1.23",
        "symfony/var-dumper": "^6.3",
        "filp/whoops": "^2.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Tests\\": "tests/"
        },
        "files": [
            "app/Utils/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "test": "phpunit",
        "cache-clear": "php cli.php cache:clear",
        "migrate": "php cli.php migrate:run",
        "seed": "php cli.php db:seed"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
