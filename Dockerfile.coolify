# =============================================================================
# Coolify Optimized Dockerfile - Production Ready
# Everything configured, migrations auto-run, single container deployment
# =============================================================================

# Stage 1: Composer Dependencies
FROM composer:2 AS composer
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader

# Stage 2: Frontend Assets (SCSS compilation)
FROM node:18-alpine AS assets
WORKDIR /app
RUN npm install -g sass
COPY public/assets/scss ./scss
RUN sass scss/main.scss:main.css --style=compressed

# Stage 3: Production Image
FROM php:8.2-fpm

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    nginx \
    supervisor \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    libicu-dev \
    libfreetype6-dev \
    libjpeg62-turbo-dev \
    libwebp-dev \
    zip \
    unzip \
    netcat-traditional \
    && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN docker-php-ext-configure gd \
        --with-freetype \
        --with-jpeg \
        --with-webp \
    && docker-php-ext-install -j$(nproc) \
        pdo_mysql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        zip \
        intl \
        opcache

# Copy Composer binary
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /var/www/html

# Copy application files
COPY . /var/www/html

# Copy Composer dependencies from stage 1
COPY --from=composer /app/vendor ./vendor

# Copy compiled CSS from stage 2
COPY --from=assets /app/main.css ./public/assets/css/main.css

# Create necessary directories and set permissions
RUN mkdir -p \
    storage/cache/i18n \
    storage/cache/rate_limits \
    storage/logs \
    storage/sessions \
    storage/uploads/media \
    public/uploads/media \
    && chown -R www-data:www-data \
        storage \
        public/uploads \
        bootstrap/cache \
    && chmod -R 755 storage public/uploads

# PHP Production Configuration
RUN { \
    echo '[PHP]'; \
    echo 'memory_limit = 256M'; \
    echo 'max_execution_time = 300'; \
    echo 'max_input_time = 300'; \
    echo 'upload_max_filesize = 100M'; \
    echo 'post_max_size = 100M'; \
    echo 'display_errors = Off'; \
    echo 'display_startup_errors = Off'; \
    echo 'error_reporting = E_ALL & ~E_DEPRECATED & ~E_STRICT'; \
    echo 'log_errors = On'; \
    echo 'error_log = /var/www/html/storage/logs/php_errors.log'; \
    echo 'date.timezone = Europe/Istanbul'; \
    echo 'expose_php = Off'; \
    echo ''; \
    echo '[opcache]'; \
    echo 'opcache.enable = 1'; \
    echo 'opcache.enable_cli = 0'; \
    echo 'opcache.memory_consumption = 128'; \
    echo 'opcache.interned_strings_buffer = 8'; \
    echo 'opcache.max_accelerated_files = 10000'; \
    echo 'opcache.revalidate_freq = 2'; \
    echo 'opcache.fast_shutdown = 1'; \
    echo 'opcache.validate_timestamps = 0'; \
    echo ''; \
    echo '[Session]'; \
    echo 'session.save_handler = files'; \
    echo 'session.save_path = "/var/www/html/storage/sessions"'; \
    echo 'session.cookie_httponly = 1'; \
    echo 'session.cookie_secure = 1'; \
    echo 'session.cookie_samesite = "Lax"'; \
} > /usr/local/etc/php/conf.d/production.ini

# PHP-FPM Configuration
RUN { \
    echo '[www]'; \
    echo 'user = www-data'; \
    echo 'group = www-data'; \
    echo 'listen = 127.0.0.1:9000'; \
    echo 'pm = dynamic'; \
    echo 'pm.max_children = 50'; \
    echo 'pm.start_servers = 5'; \
    echo 'pm.min_spare_servers = 5'; \
    echo 'pm.max_spare_servers = 35'; \
    echo 'pm.max_requests = 500'; \
    echo 'request_terminate_timeout = 300s'; \
    echo 'php_admin_value[error_log] = /var/www/html/storage/logs/php-fpm.log'; \
    echo 'php_admin_flag[log_errors] = on'; \
} > /usr/local/etc/php-fpm.d/www.conf

# Nginx Configuration
RUN rm -f /etc/nginx/sites-enabled/default && \
    { \
    echo 'server {'; \
    echo '    listen 3000;'; \
    echo '    listen [::]:3000;'; \
    echo '    server_name _;'; \
    echo '    root /var/www/html/public;'; \
    echo '    index index.php index.html;'; \
    echo '    client_max_body_size 100M;'; \
    echo '    client_body_timeout 30;'; \
    echo '    client_header_timeout 30;'; \
    echo ''; \
    echo '    # Security Headers'; \
    echo '    add_header X-Frame-Options "SAMEORIGIN" always;'; \
    echo '    add_header X-Content-Type-Options "nosniff" always;'; \
    echo '    add_header X-XSS-Protection "1; mode=block" always;'; \
    echo '    add_header Referrer-Policy "no-referrer-when-downgrade" always;'; \
    echo ''; \
    echo '    # Gzip'; \
    echo '    gzip on;'; \
    echo '    gzip_vary on;'; \
    echo '    gzip_min_length 1024;'; \
    echo '    gzip_comp_level 6;'; \
    echo '    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json;'; \
    echo ''; \
    echo '    location / {'; \
    echo '        try_files $uri $uri/ /index.php?$query_string;'; \
    echo '    }'; \
    echo ''; \
    echo '    location ~ \.php$ {'; \
    echo '        try_files $uri =404;'; \
    echo '        fastcgi_split_path_info ^(.+\.php)(/.+)$;'; \
    echo '        fastcgi_pass 127.0.0.1:9000;'; \
    echo '        fastcgi_index index.php;'; \
    echo '        include fastcgi_params;'; \
    echo '        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;'; \
    echo '        fastcgi_param PATH_INFO $fastcgi_path_info;'; \
    echo '        fastcgi_read_timeout 300;'; \
    echo '        fastcgi_send_timeout 300;'; \
    echo '        fastcgi_buffer_size 128k;'; \
    echo '        fastcgi_buffers 256 16k;'; \
    echo '        fastcgi_busy_buffers_size 256k;'; \
    echo '    }'; \
    echo ''; \
    echo '    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {'; \
    echo '        expires 1y;'; \
    echo '        add_header Cache-Control "public, immutable";'; \
    echo '        access_log off;'; \
    echo '    }'; \
    echo ''; \
    echo '    location ~ /\.(?!well-known).* {'; \
    echo '        deny all;'; \
    echo '    }'; \
    echo '}'; \
} > /etc/nginx/sites-available/default && \
ln -s /etc/nginx/sites-available/default /etc/nginx/sites-enabled/

# Supervisor Configuration (runs both Nginx and PHP-FPM)
RUN { \
    echo '[supervisord]'; \
    echo 'nodaemon=true'; \
    echo 'logfile=/var/www/html/storage/logs/supervisord.log'; \
    echo 'pidfile=/var/run/supervisord.pid'; \
    echo ''; \
    echo '[program:php-fpm]'; \
    echo 'command=php-fpm'; \
    echo 'autostart=true'; \
    echo 'autorestart=true'; \
    echo 'stdout_logfile=/var/www/html/storage/logs/php-fpm-stdout.log'; \
    echo 'stderr_logfile=/var/www/html/storage/logs/php-fpm-stderr.log'; \
    echo ''; \
    echo '[program:nginx]'; \
    echo 'command=nginx -g "daemon off;"'; \
    echo 'autostart=true'; \
    echo 'autorestart=true'; \
    echo 'stdout_logfile=/var/www/html/storage/logs/nginx-stdout.log'; \
    echo 'stderr_logfile=/var/www/html/storage/logs/nginx-stderr.log'; \
    echo ''; \
    echo '[program:worker]'; \
    echo 'command=php /var/www/html/worker.php --daemon --sleep=3'; \
    echo 'autostart=true'; \
    echo 'autorestart=true'; \
    echo 'stdout_logfile=/var/www/html/storage/logs/worker-stdout.log'; \
    echo 'stderr_logfile=/var/www/html/storage/logs/worker-stderr.log'; \
    echo 'user=www-data'; \
} > /etc/supervisor/conf.d/supervisord.conf

# Startup script
COPY docker/coolify/startup.sh /usr/local/bin/startup.sh
RUN chmod +x /usr/local/bin/startup.sh

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:3000/api/v1/health || exit 1

# Expose port 3000
EXPOSE 3000

# Start everything via startup script
CMD ["/usr/local/bin/startup.sh"]
